# ---------------------------------------------------------------
# Skopiuj ten plik jako `.env` i uzupelnij wartosci.
# Plik `.env` jest w .gitignore i nie trafia do repozytorium.
# ---------------------------------------------------------------

# --- formularz kontaktowy ---
# Adres, pod ktory formularz wysyla zapytania:
#   Web3Forms:  https://api.web3forms.com/submit
#   Formspree:  https://formspree.io/f/TWOJ_ID
#   Getform:    https://getform.io/f/TWOJ_ID
PUBLIC_ENDPOINT_FORMULARZA=

# Tylko dla Web3Forms - klucz dostepu z maila powitalnego.
PUBLIC_WEB3FORMS_KEY=

# --- wdrozenie ---
# Domena produkcyjna, bez https:// i bez ukosnika na koncu.
DOMENA=pracowniawielusmakow.pl

# Adres e-mail do powiadomien Let's Encrypt (wygasajace certyfikaty).
EMAIL_ADMINA=

# Pelny adres strony - uzywany do mapy witryny i adresow kanonicznych.
# Przy docker-compose.prod.yml ustawia sie sam z DOMENA.
SITE_URL=https://pracowniawielusmakow.pl
