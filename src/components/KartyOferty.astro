---
import { oferta } from "../data/oferta";
import Zdjecie from "./Zdjecie.astro";

export type Props = { pomin?: string };
const { pomin } = Astro.props;

/* wKartach === false → wpis ma podstronę, ale nie zajmuje kafla w siatce */
const pozycje = oferta.filter((o) => o.slug !== pomin && o.wKartach !== false);
---

<div class="k-siatka">
  {
    pozycje.map((o, i) => (
      <a class={`karta pojaw o${i}`} href={`/oferta/${o.slug}`}>
        <div class="foto">
          {
            o.zdjecie ? (
              <Zdjecie
                zrodlo={o.zdjecie}
                alt={`${o.tytul} — ${o.warianty[0].nazwa}. Pracownia Wielu Smaków, Leszno.`}
                /* Cztery kolumny, poniżej 1000 px dwie, poniżej 560 px jedna. */
                szerokosci={[320, 460, 700, 900]}
                sizes="(max-width:560px) 92vw, (max-width:1000px) 44vw, 22vw"
                szerokosc={640}
                wysokosc={480}
              />
            ) : (
              <span>{o.warianty[0].nazwa}</span>
            )
          }
        </div>
        <div class="karta-tekst">
          <small>{o.etykieta}</small>
          <h3>{o.tytul}</h3>
          <p>{o.lead}</p>
          <span class="wiecej">
            Zobacz szczegóły <span class="grot" aria-hidden="true">→</span>
          </span>
        </div>
      </a>
    ))
  }
</div>
