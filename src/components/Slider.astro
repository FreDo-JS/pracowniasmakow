---
/* Slider automatyczny — bez strzałek i bez przycisku pauzy.

   UWAGA: WCAG 2.2.2 wymaga kontrolki zatrzymującej treść, która rusza sama
   i trwa dłużej niż 5 sekund. Przycisk pauzy został usunięty na życzenie,
   więc zostają tylko częściowe zamienniki: przewijanie staje przy najechaniu
   myszą, przy fokusie klawiatury, przy dotknięciu palcem i gdy karta jest
   w tle, a przy prefers-reduced-motion nie rusza wcale.
   Pełną zgodność przywraca albo przycisk z historii gita, albo wyłączenie
   samego autoplayu (usunięcie setInterval) — kropki i palec zostają. */

import { zdjeciaSlidera } from "../data/zdjecia";
import Zdjecie from "./Zdjecie.astro";

const slajdy = [
  {
    tlo: "tlo-1",
    zdjecie: zdjeciaSlidera[0],
    opisFoto: "Zdjęcie 1 — stół weselny w stodole",
    etykieta: "Wesela i przyjęcia",
    /* H1 całej strony głównej — jedyny nagłówek pierwszego poziomu w serwisie,
       który widzi Google przy wejściu na domenę. Musi nieść usługę i miasto. */
    tytul: "Torty i catering okolicznościowy w Lesznie",
    tresc:
      "Tort, słodki stół i wytrawne przekąski z jednej pracowni w Lesznie. Projektuję, wykonuję i ustawiam wszystko na miejscu.",
    cta: { tekst: "Zamów wycenę", url: "/kontakt#formularz" },
  },
  {
    tlo: "tlo-2",
    zdjecie: zdjeciaSlidera[1],
    opisFoto: "Zdjęcie 2 — wytrawny stół, tarty i koreczki",
    etykieta: "Wytrawny stół",
    tytul: "Catering na wesela i przyjęcia",
    tresc:
      "Tarty, koreczki, deski serów i przekąski na powitanie gości — w tej samej estetyce co reszta stołu.",
    cta: { tekst: "Zobacz ofertę", url: "/oferta" },
  },
  {
    tlo: "tlo-3",
    zdjecie: zdjeciaSlidera[2],
    opisFoto: "Zdjęcie 3 — tort weselny na drewnianym wozie",
    etykieta: "Torty",
    tytul: "Tort projektowany pod jedną datę",
    tresc:
      "Weselne, urodzinowe, komunijne. Zawsze od zera, pod dekorację sali i pod smaki, które lubicie.",
    cta: { tekst: "Zobacz realizacje", url: "/realizacje" },
  },
];
---

<div
  class="slider"
  id="slider"
  aria-roledescription="karuzela"
  aria-label="Realizacje pracowni"
>
  {
    slajdy.map((s, i) => (
      <div
        class={`slajd${i === 0 ? " aktywny" : ""}`}
        role="group"
        aria-roledescription="slajd"
        aria-label={`${i + 1} z ${slajdy.length}`}
      >
        <div class={`slajd-tlo ${s.tlo}`}>
          {
            s.zdjecie && (
              <Zdjecie
                zrodlo={s.zdjecie}
                alt={s.opisFoto}
                /* Slider zajmuje całą szerokość strefy (85% okna, max 1400 px). */
                szerokosci={[700, 1000, 1400, 1900]}
                sizes="(max-width:820px) 92vw, 85vw"
                szerokosc={1600}
                wysokosc={740}
                ladowanie={i === 0 ? "eager" : "lazy"}
                /* Pierwszy slajd to obraz LCP — reszta może poczekać. */
                priorytet={i === 0}
              />
            )
          }
        </div>
        {!s.zdjecie && <span class="slajd-opis">{s.opisFoto}</span>}
        <div class="slajd-tresc">
          <p class="etykieta anim">{s.etykieta}</p>
          {i === 0 ? (
            <h1 class="slajd-tytul anim">{s.tytul}</h1>
          ) : (
            /* Tylko pierwszy slajd niesie H1 — reszta to nagłówki wizualne,
               żeby na stronie nie było trzech konkurujących H1. */
            <p class="slajd-tytul anim">{s.tytul}</p>
          )}
          <p class="anim">{s.tresc}</p>
          <a class="btn btn--jasny anim" href={s.cta.url}>
            {s.cta.tekst} <span class="grot" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    ))
  }

  <div class="sterowanie">
    <div class="kropki" role="tablist" aria-label="Wybierz slajd">
      {
        slajdy.map((s, i) => (
          <button
            class="kropka"
            role="tab"
            aria-current={i === 0 ? "true" : "false"}
            aria-label={`Slajd ${i + 1}: ${s.tytul}`}
          />
        ))
      }
    </div>
  </div>
</div>

<script>
  const wolniej = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const slider = document.getElementById("slider");

  if (slider) {
    const slajdy = [...slider.querySelectorAll<HTMLElement>(".slajd")];
    const kropki = [...slider.querySelectorAll<HTMLButtonElement>(".kropka")];
    let idx = 0;
    let timer: number | null = null;
    /* Jedyny powód, dla którego autoplay może nie ruszyć w ogóle. Reszta
       zatrzymań (najechanie, fokus, dotyk, karta w tle) jest chwilowa. */
    const bezAutoplayu = wolniej;

    const pokaz = (n: number) => {
      idx = (n + slajdy.length) % slajdy.length;
      slajdy.forEach((s, i) => s.classList.toggle("aktywny", i === idx));
      kropki.forEach((k, i) => k.setAttribute("aria-current", String(i === idx)));
    };

    const start = () => {
      if (bezAutoplayu) return;
      stop();
      timer = window.setInterval(() => pokaz(idx + 1), 6500);
    };
    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };

    kropki.forEach((k, i) =>
      k.addEventListener("click", () => {
        pokaz(i);
        start();
      })
    );

    /* zatrzymanie na czas czytania / interakcji */
    slider.addEventListener("mouseenter", stop);
    slider.addEventListener("mouseleave", start);
    slider.addEventListener("focusin", stop);
    slider.addEventListener("focusout", start);
    document.addEventListener("visibilitychange", () =>
      document.hidden ? stop() : start()
    );

    /* przesuwanie palcem */
    let x0: number | null = null;
    slider.addEventListener(
      "touchstart",
      (e) => {
        x0 = e.touches[0].clientX;
        stop();
      },
      { passive: true }
    );
    slider.addEventListener(
      "touchend",
      (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 45) pokaz(dx < 0 ? idx + 1 : idx - 1);
        x0 = null;
        start();
      },
      { passive: true }
    );

    start();
  }
</script>
